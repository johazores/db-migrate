{
  "name": "@johazores/db-migrate",
  "version": "2.0.0",
  "description": "Lightweight Node.js database migration and data portability toolkit for MongoDB, MySQL, and PostgreSQL",
  "main": "src/index.js",
  "bin": {
    "db-migrate": "bin/db-migrate.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/db-migrate.js",
    "migrate": "node bin/db-migrate.js migrate",
    "test": "node --test",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "database",
    "migration",
    "mongodb",
    "mysql",
    "postgresql",
    "export",
    "import",
    "cli"
  ],
  "author": "Johanssen Azores",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johazores/db-migrate.git"
  },
  "bugs": {
    "url": "https://github.com/johazores/db-migrate/issues"
  },
  "homepage": "https://github.com/johazores/db-migrate#readme"
}
